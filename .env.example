# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# Backend: ollama (local) | google (Gemini API)
LAB_LLM=ollama
OLLAMA_HOST=http://127.0.0.1:11434
LAB_MODEL=minimax-m3:cloud

# Chỉ cần khi LAB_LLM=google — lấy tại https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_GENAI_USE_VERTEXAI=0
